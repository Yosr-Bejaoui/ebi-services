{
  "name": "ebi-services",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && node app.js",
    "dev:agent": "cd agent && python main.py",
    "dev": "npm run dev:frontend",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "lint": "cd frontend && npm run lint",
    "install:all": "cd frontend && npm install && cd ../backend && npm install && pip install -r agent/requirements.txt"
  }
}

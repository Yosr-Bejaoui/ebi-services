# ═══════════════════════════════════════════════════════════
# EBI Services — Module 3: Demande de Devis
# ═══════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────
APP_NAME="EBI Services — Module Devis"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ── Database (PostgreSQL + asyncpg) ──────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ebi_services

# ── Auth (JWT) ────────────────────────────────────────────
SECRET_KEY=super-secret-change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Resend (email service) ───────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@ebi-services.tn

# ── File uploads ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Frontend URL (used in email links) ───────────────────
FRONTEND_URL=http://localhost:3000
